{
  "version": "people-intel-v1",
  "predicates": [
    {"id": "same_as", "domain": ["*"], "range": ["*"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "possibly_same_as", "domain": ["*"], "range": ["*"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "not_same_as", "domain": ["*"], "range": ["*"], "temporal_kind": "state", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "alias_of", "domain": ["IdentityAccount"], "range": ["Person"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "account_owned_by", "domain": ["IdentityAccount"], "range": ["Person"], "temporal_kind": "state", "multi_valued": false, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "holds_role", "domain": ["Person"], "range": ["Role"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "affiliated_with", "domain": ["Person", "LabOrTeam", "Project"], "range": ["Organization", "Institution", "LabOrTeam", "Company"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "member_of", "domain": ["Person", "Organization"], "range": ["Organization", "LabOrTeam"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "joined", "domain": ["Person"], "range": ["Organization", "Institution", "LabOrTeam", "Company"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "left", "domain": ["Person"], "range": ["Organization", "Institution", "LabOrTeam", "Company"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "founded", "domain": ["Person"], "range": ["Company", "Project"], "temporal_kind": "event", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "cofounded", "domain": ["Person"], "range": ["Company", "Project"], "temporal_kind": "event", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "authored", "domain": ["Person"], "range": ["Paper"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "coauthored_with", "domain": ["Person"], "range": ["Person"], "temporal_kind": "state", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist", "symmetric": true},
    {"id": "contributed_to", "domain": ["Person"], "range": ["Project", "Repository", "Paper"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "maintains", "domain": ["Person", "LabOrTeam", "Organization"], "range": ["Repository", "Project"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "published", "domain": ["Person", "Organization"], "range": ["Paper", "Project", "Product"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "launched", "domain": ["Person", "Company", "Organization"], "range": ["Project", "Product", "Repository"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "raised_funding", "domain": ["Company", "Project"], "range": ["FundingRound"], "temporal_kind": "event", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "invested_in", "domain": ["Person", "Organization", "Company"], "range": ["Company", "Project", "FundingRound"], "temporal_kind": "event", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "advised_by", "domain": ["Person", "Project", "Company"], "range": ["Person", "Organization"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "studied_at", "domain": ["Person"], "range": ["Institution"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "worked_at", "domain": ["Person"], "range": ["Organization", "Institution", "Company"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "rank"},
    {"id": "collaborated_with", "domain": ["Person", "Organization", "Project"], "range": ["Person", "Organization", "Project"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "awarded", "domain": ["Person", "Paper", "Project"], "range": ["Award"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "spun_out_from", "domain": ["Company", "Project"], "range": ["Institution", "Organization", "LabOrTeam", "Company"], "temporal_kind": "event", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "interested_in", "domain": ["Person", "Organization", "Company"], "range": ["Topic"], "temporal_kind": "state", "multi_valued": true, "allow_negative": true, "conflict_strategy": "coexist"},
    {"id": "profile_claim", "domain": ["Person"], "range": ["Literal"], "temporal_kind": "state", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"},
    {"id": "mentioned_in", "domain": ["*"], "range": ["Event", "Paper", "Project"], "temporal_kind": "event", "multi_valued": true, "allow_negative": false, "conflict_strategy": "coexist"}
  ]
}
